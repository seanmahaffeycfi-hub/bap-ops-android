<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/lastEndingMileageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last recorded ending mileage: (none yet)"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Date" />

        <Button
            android:id="@+id/dateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Date" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Starting Mileage (fresh odometer read, cannot match last ending mileage)" />

        <EditText
            android:id="@+id/startMileageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0.0"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/captureStartLocationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Capture Start Location" />

        <TextView
            android:id="@+id/startLocationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start location: not captured"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ending Mileage" />

        <EditText
            android:id="@+id/endMileageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0.0"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/captureEndLocationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Capture End Location" />

        <TextView
            android:id="@+id/endLocationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="End location: not captured"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tag" />

        <RadioGroup
            android:id="@+id/recordTypeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio1099"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="1099" />

            <RadioButton
                android:id="@+id/radio501"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="501" />
        </RadioGroup>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:text="Save Mileage Entry" />

    </LinearLayout>
</ScrollView>